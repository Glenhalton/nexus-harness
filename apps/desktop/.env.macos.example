# Copy to .env.macos (Git ignored). Use UTF-8 and quote secrets containing # or spaces.
# Paths may be absolute or relative to apps/desktop. Values are not shell-expanded.
DSH_DESKTOP_APP_ID=africa.gda.nexus-harness
# github (default): installers and the update feed live on GitHub Releases of Glenhalton/nexus-harness.
# test / production: the inherited Tencent COS deployments; they need the DOWNLOAD_* and mandatory-update settings below.
DSH_DESKTOP_AUTO_UPDATE_ENV=github

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com

# Workspace tarball workers; omit to use 4. Must be a positive integer.
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
# Optional independent proxy origins; empty values preserve inherited networking.
# Downloads: HTTP/HTTPS proxy for Electron, runtime assets, pnpm and builder downloads.
DSH_DESKTOP_MACOS_DOWNLOAD_PROXY=
# Apple tools: HTTP proxy temporarily applied to the active macOS network service.
# Requires permission to change system proxies; affects other applications during notarization.
DSH_DESKTOP_MACOS_NOTARIZATION_PROXY=

# Signing. Leave every setting below empty or commented out to build an unsigned, ad-hoc signed app
# (not notarized). Setting any of them selects Developer ID signing + notarization, which then needs all of:
# DSH_DESKTOP_MACOS_SIGNING_IDENTITY: certificate name without the "Developer ID Application:" prefix,
#   for example "GDA Africa (ABCDE12345)".
# DSH_DESKTOP_MACOS_TEAM_ID: the 10-character Apple Team ID.
# CSC_LINK: local p12 with the Developer ID Application certificate and private key.
# CSC_KEY_PASSWORD: the p12 export password (an explicit empty value for an unencrypted p12).
DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
DSH_DESKTOP_MACOS_TEAM_ID=
CSC_LINK=
CSC_KEY_PASSWORD=

# Choose exactly one notarization strategy; leave the others commented out.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# APPLE_KEYCHAIN_PROFILE=
# APPLE_KEYCHAIN=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Inherited COS deployments only (DSH_DESKTOP_AUTO_UPDATE_ENV=test or production).
# DOWNLOAD_TEST_ORIGIN=
# DOWNLOAD_TEST_RELEASE_ID=
# DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
# DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
# DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
# DOWNLOAD_PROD_COS_BUCKET=
# DOWNLOAD_PROD_COS_SECRET_ID=
# DOWNLOAD_PROD_COS_SECRET_KEY=
